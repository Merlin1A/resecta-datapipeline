# Build output — never committed; regenerated by `make build`.
build/

# ParaNames corpus: the ~954 MB full file is fetched on demand by
# scripts/fetch_paranames.sh (not committed — too large to ship; no Git-LFS).
# Shards are regenerated from it by scripts/shard_paranames.py.
src/resecta_data/gazetteers/sources/paranames/paranames_full.tsv.gz
src/resecta_data/gazetteers/sources/paranames/shards/

# Virtualenv created by scripts/bootstrap.sh.
.venv/
venv/

# Tool caches.
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Python artifacts.
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg

# IDE noise.
.idea/
.vscode/
.zed/
*.swp
*.swo

# OS noise.
.DS_Store
Thumbs.db

# Test-corpus artifacts (regenerable).
# Phase 3 corpus outputs are generated into the Swift Fixtures path, not here.
# Listed defensively in case someone runs the generator with a local output dir.
g8_corpus_output/

# Hypothesis property-test database (regenerable).
.hypothesis/

# Per-machine Claude Code settings (user-specific, not for collaborators).
.claude/settings.local.json

# Transient lock file created by scripts/_fetch_lib.sh::append_sources_row to
# serialise concurrent SOURCES.md appenders (orchestration.md §5).
SOURCES.md.lock
